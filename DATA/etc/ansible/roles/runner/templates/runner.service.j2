[Unit]
Description=MARE GitHub Actions runner {{ runner_instance.name }}
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ runner_instance.user }}
Group={{ runner_instance.user }}
SupplementaryGroups={{ runner_groups | join(' ') }}
WorkingDirectory={{ runner_instance.install_dir }}
Environment="HOME={{ runner_home_root }}/{{ runner_instance.user }}"
Environment="PATH={{ runner_effective_service_path }}"
Environment="TMPDIR={{ runner_instance.work_dir }}/.tmp"
{% if minikube_enabled | default(kubernetes_enabled | default(true)) | bool %}
Environment="KUBECONFIG={{ runner_home_root }}/{{ runner_instance.user }}/.config/runner-kubernetes/{{ runner_instance.minikube_profile | default((minikube_profile | default('minikube')) ~ ('-' ~ runner_instance.name if runner_instances | length > 1 else '')) }}/config"
Environment="MINIKUBE_PROFILE={{ runner_instance.minikube_profile | default((minikube_profile | default('minikube')) ~ ('-' ~ runner_instance.name if runner_instances | length > 1 else '')) }}"
{% endif %}
{% if virtualization_enabled | bool %}
Environment="LIBVIRT_DEFAULT_URI=qemu:///system"
{% endif %}
{% if vagrant_libvirt_enabled | default(virtualization_enabled) | bool %}
Environment="VAGRANT_DEFAULT_PROVIDER=libvirt"
{% endif %}
ExecStart={{ runner_instance.install_dir }}/runsvc.sh
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
ProtectHome=tmpfs
BindPaths={{ runner_home_root }}/{{ runner_instance.user }} {{ runner_instance.install_dir }} {{ runner_instance.work_dir }}
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Docker bind mounts must resolve the same temporary paths in the host daemon.
# Wasmtime JIT and KVM also require executable memory and device access.
PrivateTmp=no
PrivateDevices=no

[Install]
WantedBy=multi-user.target
